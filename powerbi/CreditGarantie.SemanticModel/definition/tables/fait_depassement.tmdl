table fait_depassement

	column num_compte
		dataType: string
		summarizeBy: none
		sourceColumn: num_compte

		annotation SummarizationSetBy = Automatic

	column compte_general
		dataType: string
		summarizeBy: none
		sourceColumn: compte_general

		annotation SummarizationSetBy = Automatic

	column date_entree
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date_entree

		annotation SummarizationSetBy = Automatic

	column date_sortie
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date_sortie

		annotation SummarizationSetBy = Automatic

	column mnt_depassement
		dataType: double
		summarizeBy: none
		sourceColumn: mnt_depassement

		annotation SummarizationSetBy = Automatic

	column date_arrete
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date_arrete

		annotation SummarizationSetBy = Automatic

	partition fait_depassement = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Alienware\Desktop\datalake\exports\fait_depassement.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Converted = Table.TransformColumns(Promoted, {
				        {"date_entree", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"date_sortie", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"mnt_depassement", each try Number.FromText(Text.Replace(_, ",", "."), "en-US") otherwise null},
				        {"date_arrete", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null}
				    }),
				    Typed = Table.TransformColumnTypes(Converted, {
				        {"date_entree", type date},
				        {"date_sortie", type date},
				        {"mnt_depassement", type number},
				        {"date_arrete", type date}
				    })
				in
				    Typed

table gdw_synthese_credit
	lineageTag: b7d54a85-5a4f-46e3-8b1c-1351f2ba58a1

	measure 'Encours Total' = SUM(gdw_synthese_credit[encours])
		formatString: #,0
		lineageTag: 28bf438e-06de-4f2f-b4e2-c38defd16d27

	measure 'Montant Crédit' = SUM(gdw_synthese_credit[mnt_credit])
		formatString: #,0
		lineageTag: c1315217-4fdc-43c5-8b76-5bfb6b826caa

	measure 'Nombre Crédits' = DISTINCTCOUNT(gdw_synthese_credit[idf_num_doss])
		formatString: #,0
		lineageTag: a4b0d555-f128-4cfc-8e36-0da7a84b1b3a

	measure 'Ticket Moyen' = DIVIDE([Montant Crédit], [Nombre Crédits])
		formatString: #,0
		lineageTag: aba82c71-562f-413c-a4da-9a2072924987

	measure 'Montant Impayés' = SUM(gdw_impayes[mnt_impayes_cdl])
		formatString: #,0
		lineageTag: 44ccdf7c-f667-47e0-95f8-cd6af645acc5

	measure 'Montant Créances' = SUM(gdw_impayes[mnt_creance])
		formatString: #,0
		lineageTag: 7756e463-e9cc-4949-a4c6-29a06a36fed0

	measure 'Taux Impayé' = DIVIDE([Montant Impayés], [Encours Total])
		formatString: 0.0%
		lineageTag: b2d2ab95-f6df-427a-ac6a-ec476c48f4d3

	measure 'Montant en Défaut' = CALCULATE([Encours Total], gdw_synthese_credit[flag_cdl] = TRUE())
		formatString: #,0
		lineageTag: 3ebbb2a0-8d7d-4de8-9c90-54380cd000c9

	measure NPL = DIVIDE([Montant en Défaut], [Encours Total])
		formatString: 0.0%
		lineageTag: 3b4109f8-40b3-42a4-a3ca-c4e8da687b9d

	measure 'Valeur Garanties' = SUM(fait_garanties[mnt_total_garantie])
		formatString: #,0
		lineageTag: 509527eb-69ec-4996-8a11-17df55b87069

	measure 'Taux Couverture' = DIVIDE([Valeur Garanties], [Encours Total])
		formatString: 0.0%
		lineageTag: af0ccccc-8ea0-48a2-9c56-49cf2134faca

	measure 'Risque Net' = [Encours Total] - [Valeur Garanties]
		formatString: #,0
		lineageTag: d9efb417-1adf-4b29-a0ba-9a5efa607cdb

	measure 'Montant Autorisé' = SUM(fait_autorisations[montant_autorise])
		formatString: #,0
		lineageTag: e3e5da10-6a57-4646-b63e-05e15367d015

	measure 'Montant Utilisé' = SUM(fait_autorisations[montant_utilise])
		formatString: #,0
		lineageTag: a5666561-0859-4066-85c7-aa9c94e41358

	measure 'Taux Utilisation' = DIVIDE([Montant Utilisé], [Montant Autorisé])
		formatString: 0.0%
		lineageTag: 843288fa-9e21-4d72-b367-e68d4bc62947

	measure 'Montant Dépassement' = SUM(fait_depassement[mnt_depassement])
		formatString: #,0
		lineageTag: c92698ae-d8a4-4867-aaf4-5780189853d5


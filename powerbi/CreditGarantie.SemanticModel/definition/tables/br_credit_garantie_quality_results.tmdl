	partition br_credit_garantie_quality_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Alienware\Desktop\datalake\exports\br_credit_garantie_quality_results.csv"), [Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Converted = Table.TransformColumns(Promoted, {
				        {"alert_threshold_pct", each try Number.FromText(_, "en-US") otherwise null},
				        {"date_situation", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"duration_seconds", each try Number.FromText(_, "en-US") otherwise null},
				        {"execution_date", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"failure_rate_pct", each try Number.FromText(_, "en-US") otherwise null},
				        {"passed", each if _ = null then null else Text.Lower(_) = "true"},
				        {"passed_percentage", each try Number.FromText(_, "en-US") otherwise null},
				        {"records_checked", each try Int64.From(_) otherwise null},
				        {"records_failed", each try Int64.From(_) otherwise null},
				        {"table_partition_exists", each if _ = null then null else Text.Lower(_) = "true"}
				    }),
				    Typed = Table.TransformColumnTypes(Converted, {
				        {"alert_threshold_pct", type number},
				        {"date_situation", type date},
				        {"duration_seconds", type number},
				        {"execution_date", type date},
				        {"failure_rate_pct", type number},
				        {"passed", type logical},
				        {"passed_percentage", type number},
				        {"records_checked", Int64.Type},
				        {"records_failed", Int64.Type},
				        {"table_partition_exists", type logical}
				    })
				in
				    Typed


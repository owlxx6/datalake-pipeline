	column 'Classe CDL' = SWITCH(gdw_impayes[cod_statut_incident], "PD","1-Pré-douteux", "DT","2-Douteux", "CP","3-Compromis", "IM","0-Impayé", "RB","Sain", BLANK())
		dataType: string
		lineageTag: a2ea0fc6-8535-44c4-826d-62c3467e877a
		summarizeBy: none

	column 'Aging Jours' = DATEDIFF(gdw_impayes[date_mise_impaye], gdw_impayes[date_arrete], DAY)
		dataType: int64
		lineageTag: a6e133b4-e279-4313-bd4c-1a76969fa0af
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tranche Aging' = SWITCH(TRUE(), ISBLANK(gdw_impayes[date_mise_impaye]), "Non daté", gdw_impayes[Aging Jours] <= 30, "0-30j", gdw_impayes[Aging Jours] <= 60, "30-60j", gdw_impayes[Aging Jours] <= 90, "60-90j", "90j+")
		dataType: string
		lineageTag: a449d809-c134-4525-8220-4dc2f60c811f
		summarizeBy: none

	partition gdw_impayes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Alienware\Desktop\datalake\exports\gdw_impayes.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Converted = Table.TransformColumns(Promoted, {
				        {"mnt_impayes_cdl", each try Number.FromText(_, "en-US") otherwise null},
				        {"mnt_creance", each try Number.FromText(_, "en-US") otherwise null},
				        {"date_mise_impaye", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"date_echeance", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null},
				        {"date_arrete", each try #date(Number.FromText(Text.Start(_,4)), Number.FromText(Text.Middle(_,5,2)), Number.FromText(Text.Middle(_,8,2))) otherwise null}
				    }),
				    Typed = Table.TransformColumnTypes(Converted, {
				        {"mnt_impayes_cdl", type number},
				        {"mnt_creance", type number},
				        {"date_mise_impaye", type date},
				        {"date_echeance", type date},
				        {"date_arrete", type date}
				    })
				in
				    Typed

